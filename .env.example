# Application environment: development | test | production.
# Settings loads THIS repository-root .env only; backend/.env is NOT read.
# With APP_ENV=production the backend refuses to start at import time unless
# COLLAB_SECRET_KEY below is set to a strong random value (missing/empty fails).
APP_ENV=development

POSTGRES_PASSWORD=replace_with_local_secret
NEO4J_PASSWORD=replace_with_local_secret
DATABASE_URL=postgresql+psycopg://diseasegraph:replace_with_local_secret@127.0.0.1:5432/diseasegraph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
GRAPH_SOURCE=csv
GRAPH_DATA_DIR=experiments/platform_phase_b
MAX_GRAPH_NODES=200
MAX_GRAPH_DEPTH=2

# Collaboration center (isolated from the formal KG). Set a strong random value in production.
# REQUIRED when APP_ENV=production: startup fails immediately if missing or empty.
# Never use the public development fallback constant as a production key.
COLLAB_SECRET_KEY=replace_with_random_secret
COLLAB_TOKEN_TTL_MINUTES=720

# AI drug interpretation (DeepSeek Flash). Keep the real key in this repository-root .env only
# (Settings does not read backend/.env). Never commit a real key, never expose it to the frontend or logs.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
